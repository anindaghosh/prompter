# Custom logo (optional) — path like /logo.png or /logo.svg; defaults to /logo.svg
# NEXT_PUBLIC_LOGO_URL=/logo.png

# ─── SpacetimeDB ─────────────────────────────────────────────────────────────
# Production (SpacetimeDB Cloud maincloud):
NEXT_PUBLIC_SPACETIMEDB_URL=wss://maincloud.spacetimedb.com
# Local dev (spacetime start):
# NEXT_PUBLIC_SPACETIMEDB_URL=ws://localhost:3000

# The database name published via: spacetime publish prompter-hack
NEXT_PUBLIC_SPACETIMEDB_MODULE=prompter-hack

# ─── Gemini API ──────────────────────────────────────────────────────────────
# Used by /api/generate-image and /api/score-image
# Get key from https://ai.google.dev/
GEMINI_API_KEY=
